# =============================================================================
# Imno Agente — DEPLOY inputs. Copy to `.env.production` (gitignored) and fill
# in. This one file drives the whole deployment:
#
#   pnpm cf:secrets       pushes the Worker's variables to Cloudflare
#   pnpm db:setup:remote  migrates the deployed D1 database from here
#   pnpm verify:env:prod  checks it is complete before you spend a deploy
#   pnpm verify:health    pings every deployed service
#
# The Render side is set from render.yaml (the Blueprint prompts for the
# `sync: false` entries), so the values below marked "also on Render" must be
# typed identically there. See DEPLOY.md.
# =============================================================================

# --- Cloudflare account (only used by wrangler from your laptop) ---
# CLOUDFLARE_ENV=production makes the CLI scripts use wrangler's REMOTE bindings,
# i.e. the real deployed D1/R2 rather than the local emulation.
# Get the account id from `pnpm cf:whoami`.
# Do NOT add CLOUDFLARE_API_TOKEN unless you have a real one: `pnpm cf:login`
# stores an OAuth token that wrangler prefers, and a placeholder token variable
# would override it and break every wrangler call. CI needs a real token with
# D1 Edit + Workers R2 Storage Edit + Workers Scripts Edit.
CLOUDFLARE_ENV=production
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# --- Origins (fill in after the first deploy of each side) ---
# API_URL              the Worker, e.g. https://imno-api.<subdomain>.workers.dev
# APP_URL              the Render frontend, https://imno-frontend.onrender.com
# AGENT_INTERNAL_URL   the Render agent, https://imno-agent.onrender.com
#                      (public: the Worker runs on Cloudflare and cannot reach
#                      Render's private network — the HMAC secret guards it)
API_URL=replace-with-worker-url
APP_URL=replace-with-frontend-url
AGENT_INTERNAL_URL=replace-with-agent-url

# --- Secrets ---
# openssl rand -hex 32 for each. INTERNAL_SERVICE_SECRET is also on Render.
PAYLOAD_SECRET=replace-with-production-payload-secret
INTERNAL_SERVICE_SECRET=replace-with-production-service-secret

# --- Evolution API on Render ---
# EVOLUTION_API_KEY must equal AUTHENTICATION_API_KEY on the imno-evolution
# service. The webhook URL must point at the Worker.
# All four EVOLUTION_* secrets/prefix are also on Render.
EVOLUTION_BASE_URL=replace-with-evolution-url
EVOLUTION_PUBLIC_URL=replace-with-evolution-url
EVOLUTION_API_KEY=replace-with-production-evolution-key
EVOLUTION_INSTANCE_PREFIX=imno-agent
EVOLUTION_WEBHOOK_SECRET=replace-with-production-webhook-secret
EVOLUTION_WEBHOOK_URL=replace-with-worker-url/api/webhooks/evolution

# --- Language model (agent only; set on Render, kept here for reference) ---
LLM_ADAPTER=default
LLM_API_KEY=replace-with-model-key
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com

# --- Content ---
CONTENT_DEFAULT_LANGUAGE=es
