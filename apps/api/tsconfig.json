{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "verbatimModuleSyntax": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload.config.ts"],
      "@imno/contracts": ["../../packages/contracts/src/index.ts"],
      "@imno/domain": ["../../packages/domain/src/index.ts"],
      "@imno/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@imno/content-core": ["../../packages/content-core/src/index.ts"],
      "@imno/integration-evolution": ["../../packages/integration-evolution/src/index.ts"],
      "@imno/integration-llm": ["../../packages/integration-llm/src/index.ts"],
      "@imno/integration-ffmpeg": ["../../packages/integration-ffmpeg/src/index.ts"],
      "@imno/runtime-config": ["../../packages/runtime-config/src/index.ts"],
      "@imno/test-support": ["../../packages/test-support/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "global.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".open-next", ".wrangler"]
}
