{
  "name": "api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/api/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/api/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/api"
      }
    },
    "next:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/api"
      }
    },
    "build:worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "opennextjs-cloudflare build",
        "cwd": "apps/api"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env production",
        "cwd": "apps/api"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -p 3001",
        "cwd": "apps/api"
      }
    },
    "generate:types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "payload generate:types",
        "cwd": "apps/api"
      }
    },
    "generate:importmap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "payload generate:importmap",
        "cwd": "apps/api"
      }
    }
  }
}
