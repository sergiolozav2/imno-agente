# =============================================================================
# Imno Agente — local environment sample.
# Copy to `.env` and replace placeholder secrets. Server-only values MUST NOT
# use a NEXT_PUBLIC_ prefix.
# =============================================================================

# --- Web / browser boundary (same-origin BFF) ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AGENT_INTERNAL_URL=http://localhost:3002

# --- Internal service auth (API <-> agent HMAC) ---
INTERNAL_SERVICE_SECRET=replace-with-local-service-secret

# --- Payload / Cloudflare bindings ---
PAYLOAD_SECRET=replace-with-local-payload-secret
CLOUDFLARE_ENV=local
CLOUDFLARE_D1_BINDING=D1
CLOUDFLARE_R2_BINDING=R2

# --- Evolution API (WhatsApp) ---
EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_PUBLIC_URL=http://localhost:8081
EVOLUTION_API_KEY=replace-with-local-evolution-key
EVOLUTION_INSTANCE_PREFIX=imno-agent
EVOLUTION_WEBHOOK_SECRET=replace-with-local-webhook-secret
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3001/api/webhooks/evolution

# --- Configured language model (provider-neutral) ---
LLM_ADAPTER=default
LLM_API_KEY=replace-with-model-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# --- Content + local video ---
CONTENT_DEFAULT_LANGUAGE=es
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_TEMP_DIR=.tmp/video
VIDEO_DEFAULT_ASPECT_RATIO=9:16

# --- Deferred media providers ---
TRANSCRIPTION_PROVIDER=unsupported
VOICE_PROVIDER=unsupported
IMAGE_ENHANCEMENT_PROVIDER=pass-through
