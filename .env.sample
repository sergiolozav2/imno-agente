# =============================================================================
# Imno Agente — LOCAL environment. Copy to `.env` and replace every
# `replace-with-…` value; the config loaders treat that prefix as "not set".
# Check it with `pnpm verify:env`.
#
# For deploying, see `.env.production.sample` and DEPLOY.md.
# Server-only values MUST NOT use a NEXT_PUBLIC_ prefix.
# =============================================================================

# --- Origins ---
# APP_URL  frontend (Next.js UI + BFF)
# API_URL  Payload CMS / REST API — locally `next dev`, in production the Worker
# AGENT_INTERNAL_URL  Mastra agent runtime, called by the API and the frontend
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AGENT_INTERNAL_URL=http://localhost:3002

# --- Internal service auth ---
# HMAC secret for API <-> agent and frontend -> agent calls. Every service that
# signs or verifies a call must hold the SAME value.
# Generate one: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=replace-with-local-service-secret

# --- Payload / Cloudflare ---
# PAYLOAD_SECRET signs Payload's admin sessions: openssl rand -hex 32
# CLOUDFLARE_ENV picks which D1/R2 the CLI scripts touch. `local` uses the
# wrangler-emulated state under apps/api/.wrangler; the deployed Worker gets its
# database and bucket as bindings and reads neither of these.
PAYLOAD_SECRET=replace-with-local-payload-secret
CLOUDFLARE_ENV=local

# --- Evolution API (WhatsApp), from docker-compose.yml ---
# BASE_URL is server-to-server, PUBLIC_URL is what a browser/QR flow opens.
# WEBHOOK_URL is where Evolution posts inbound messages; on Linux the container
# reaches the host through host.docker.internal (mapped in docker-compose.yml).
EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_PUBLIC_URL=http://localhost:8081
EVOLUTION_API_KEY=replace-with-local-evolution-key
EVOLUTION_INSTANCE_PREFIX=imno-agent
EVOLUTION_WEBHOOK_SECRET=replace-with-local-webhook-secret
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3001/api/webhooks/evolution

# --- Language model (provider-neutral, agent only) ---
LLM_ADAPTER=default
LLM_API_KEY=replace-with-model-key
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com

# --- Content ---
CONTENT_DEFAULT_LANGUAGE=es

# --- Optional ---
# Agent thread store. Defaults to .mastra/agent-memory.db at the repo root.
# MASTRA_STORAGE_URL=file:./.mastra/agent-memory.db
# Names the system WhatsApp line for `pnpm wa:connect`. Optional: it defaults to
# SYSTEM_<EVOLUTION_INSTANCE_PREFIX>, and the paired line is read from the
# system-whatsapp global at runtime, not from here. See WHATSAPP_SYSTEM_AGENT.md.
# SYSTEM_WHATSAPP_INSTANCE=
