{
  "name": "imnoagente",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant real estate AI agent workspace.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "db:setup": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/setup.ts",
    "db:seed": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/seed.ts",
    "db:reset": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/reset.ts",
    "db:reset:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/reset.ts",
    "db:setup:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/setup.ts",
    "db:seed:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/seed.ts",
    "db:insert-c21": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/insert-c21-properties.ts",
    "db:insert-c21:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/insert-c21-properties.ts",
    "db:reseed": "pnpm db:reset && pnpm db:seed",
    "db:reseed:remote": "pnpm db:reset:remote && pnpm db:seed:remote",
    "db:migrate:create": "cd apps/api && node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/payload migrate:create",
    "evolution:keys": "cd apps/api && node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/evolution-keys.ts",
    "wa:list": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/system-whatsapp-list.ts",
    "wa:connect": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/system-whatsapp-connect.ts",
    "wa:delete": "cd apps/api && NODE_ENV=production node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/system-whatsapp-delete.ts",
    "wa:list:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/system-whatsapp-list.ts",
    "wa:connect:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/system-whatsapp-connect.ts",
    "wa:delete:remote": "cd apps/api && NODE_ENV=production node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/system-whatsapp-delete.ts",
    "map:data": "tsx scripts/c21/build-map-data.ts",
    "reel:smoke": "cd apps/agent && node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/reel-smoke.ts",
    "bridge:probe": "cd apps/agent && node \"--env-file=$(pwd)/../../.env\" ../../node_modules/.bin/tsx src/scripts/bridge-probe.ts",
    "bridge:probe:remote": "cd apps/agent && node \"--env-file-if-exists=$(pwd)/../../.env.production\" ../../node_modules/.bin/tsx src/scripts/bridge-probe.ts",
    "generate:types": "nx generate:types api",
    "dev:api": "nx dev api",
    "dev:agent": "nx serve agent",
    "dev:frontend": "nx dev frontend",
    "dev": "nx run-many -t dev serve --parallel=3",
    "cf:login": "pnpm --filter @imno/api exec wrangler login",
    "cf:whoami": "pnpm --filter @imno/api exec wrangler whoami",
    "cf:create": "pnpm --filter @imno/api exec wrangler d1 create imno-production && pnpm --filter @imno/api exec wrangler r2 bucket create imno-media",
    "cf:secrets": "node tools/deploy/cf-secrets.mjs",
    "cf:logs": "pnpm --filter @imno/api exec wrangler tail --env production",
    "deploy:api": "nx deploy api",
    "preview:api": "cd apps/api && pnpm preview",
    "deploy:render": "render deploys create",
    "render:login": "render login",
    "render:services": "render services",
    "render:logs": "render logs",
    "verify": "node tools/deploy/verify.mjs env .env && pnpm lint && pnpm test",
    "verify:env": "node tools/deploy/verify.mjs env .env",
    "verify:env:prod": "node tools/deploy/verify.mjs env .env.production",
    "verify:render": "render blueprints validate ./render.yaml",
    "verify:build": "nx run-many -t next:build build:worker --projects=api,frontend",
    "verify:docker": "docker build -f apps/frontend/Dockerfile --build-arg API_URL=http://localhost:3001 -t imno-frontend . && docker build -f apps/agent/Dockerfile -t imno-agent .",
    "verify:health": "node tools/deploy/verify.mjs health .env.production",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.14.1",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nx": "21.2.2",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.25.76"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "@swc/core",
      "sharp",
      "workerd"
    ]
  }
}
